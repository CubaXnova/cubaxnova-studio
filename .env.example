# Copia este archivo a .env y cambia los valores.

# Contraseña para entrar en la web (obligatoria, usa una larga).
STUDIO_PASSWORD=cambia-esto-por-una-clave-larga

# Por defecto solo escucha en el propio servidor (127.0.0.1).
# Entra con un túnel SSH o pon nginx con HTTPS delante. No lo abras a 0.0.0.0 sin HTTPS.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=7860

# Carpeta donde trabajan los agentes (por defecto ./workspace dentro del proyecto).
# STUDIO_WORKSPACE=/opt/cubaxnova-studio/workspace

# Codex
# CODEX_MODEL=
# Permisos de los comandos de Codex: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write

# Máximo de subagentes por turno
STUDIO_MAX_DELEGATIONS=3
