# Servicio systemd propio. Corre con el usuario "studio", que NO tiene acceso a tus otros proyectos.
[Unit]
Description=CubaXnova Studio
After=network.target

[Service]
Type=simple
User=studio
Group=studio
WorkingDirectory=/opt/cubaxnova-studio
ExecStart=/usr/bin/env node server/index.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
# Caja de seguridad: Studio (y Codex y la terminal) solo pueden ESCRIBIR en su carpeta.
# El resto del sistema queda en solo lectura, /home y /root ocultos, /tmp propio.
ProtectSystem=strict
ReadWritePaths=/opt/cubaxnova-studio
ProtectHome=true
PrivateTmp=true
# Límites para que nunca le quite recursos a producción
MemoryMax=1500M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
